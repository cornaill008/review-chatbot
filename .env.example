# 환경변수 예시. 실제 값은 .env.local에 넣고 커밋하지 않는다. 이 파일에는 변수 이름과 빈 값만 둔다.

# 'false'가 아니면 Mock 모드(samples/review.csv + 인메모리 저장소).
# 4단계(Pinecone + Supabase) 구현이 끝나기 전에는 true를 유지한다.
USE_MOCK=true

# Kimi (Moonshot AI) - 답변 생성용 LLM API 키.
# 비어 있으면 답변 생성을 생략하고 검색 결과 JSON만 보여준다.
KIMI_API_KEY=
# 선택. 비워 두면 기본값을 쓴다: kimi-k2.6 / https://api.moonshot.ai/v1
# (키가 중국 리전 것이면 KIMI_BASE_URL=https://api.moonshot.cn/v1)
KIMI_MODEL=
KIMI_BASE_URL=

# Pinecone (4단계)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=review-chatbot
PINECONE_HOST=

# Supabase (4단계)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 구 프로젝트라 anon 키만 보이는 경우:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
